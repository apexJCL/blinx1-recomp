# Launcher defaults (macOS). Do not edit this file: a new app replaces it.
# Put your own KEY=value lines in
# ~/Library/Application Support/BLiNX1/config/launch.env; they win
# over these. Any RECOMP_* key from docs/running.md works there, e.g.
# RECOMP_USB_PADS=1 or RECOMP_PB_BACKEND=cpu (the software renderer, slower).
RECOMP_PB_BACKEND=metal
# The keyboard as player 1, read only while the game window has focus.
# Controllers (through SDL) work without this.
RECOMP_KEYBOARD=1
# The emulated MCPX APU DSP runs the game's own audio effects (reverb, the
# game's mix). RECOMP_APU_DSP=0 in config/launch.env goes back to the plain
# mix (the stub):
# RECOMP_APU_DSP=0
# Game logs kept in logs/.
LOG_KEEP=10
